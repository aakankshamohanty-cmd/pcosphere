rules_version = '2';

// PCOSphere: phones never read or write the database directly.
// Every action goes through the server functions in /api, which check who is asking
// and enforce the rules (consent, max 2 people, active links only).
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
